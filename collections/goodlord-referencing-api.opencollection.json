        {
          "info": {
            "name": "Patch Subject",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.goodoverlord.com/referencing/subject/:subjectId",
            "headers": [
              {
                "name": "Company-ID",
                "value": "e2baa1a0-1234-5678-9abc-def012345678"
              }
            ],
            "params": [
              {
                "name": "subjectId",
                "value": "",
                "type": "path",
                "description": "SubjectId you wish to generate a token for"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Patch a subject you have already created"
